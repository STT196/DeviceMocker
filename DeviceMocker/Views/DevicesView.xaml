                                    <!-- Tag Badge -->
                                    <Border Grid.Column="1" Background="#1AF59E0B" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" Height="22">
                                        <TextBlock Text="HARDWARE" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                
                                <TextBlock Grid.Row="1" Text="Cash Drawer" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,0"/>
                                <TextBlock Grid.Row="2" Text="Simulate status inputs and kick trigger feedback for cash drawer drawers." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14.5"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SecondaryBrush}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#F59E0B" BlurRadius="18" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="iconBg" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                <Setter TargetName="iconBg" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </UniformGrid>
    </StackPanel>
</UserControl>

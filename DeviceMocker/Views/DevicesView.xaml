<UserControl x:Class="DeviceMocker.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Available Device Emulators" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Select an input device below to open its dedicated hardware simulator" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

        <!-- Grid of Devices -->
        <UniformGrid Columns="4" Margin="0,0,0,8">

            <!-- Barcode Scanner -->
            <Button Margin="0,0,8,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="scanner">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A7C3AED" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="KEYBOARD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="🔍" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Barcode / QR" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Simulate barcode scanner sweeps sending keystrokes directly to focused fields." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Virtual Keyboard -->
            <Button Margin="4,0,4,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="virtual-keyboard">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A7C3AED" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="KEYBOARD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="⌨" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Virtual Keyboard" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Simulate keys, text sequences, and function shortcuts with controllable delay." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Custom Button Panel -->
            <Button Margin="4,0,4,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="custom-panel">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A7C3AED" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="KEYBOARD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="🎛" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Button Panel" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Trigger custom keyboard layout inputs using customizable Quick POS panel grids." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Serial Text Sender -->
            <Button Margin="8,0,0,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="serial-device">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A10B981" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="COM PORT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="🔌" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Serial Port" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Transmit raw string data and HEX logs directly to native virtual COM serial ports." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Weighing Scale -->
            <Button Margin="0,0,8,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="scale">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A10B981" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="COM PORT" FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="⚖" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Weighing Scale" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Simulate scale weigh triggers sending stable weight units to checking points." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- RFID NFC Reader -->
            <Button Margin="4,0,4,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="rfid-reader">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A7C3AED" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="KEYBOARD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="🏷" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="RFID / NFC Reader" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Trigger secure card chip tags and contactless code readings on tap events." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Magstripe Reader -->
            <Button Margin="4,0,4,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="magstripe-reader">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1A7C3AED" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="KEYBOARD" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentLightBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="💳" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Magstripe Reader" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Emulate magnetic card swipe gestures by streaming complete multi-track card data." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Sequence Builder -->
            <Button Margin="8,0,0,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="sequence-builder">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1AF59E0B" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="AUTOMATION" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="⛓" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Sequence Builder" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Compose custom sequential events with custom delay timers to replay complex logs." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Cash Drawer -->
            <Button Margin="0,0,8,12" Cursor="Hand" Command="{Binding OpenDeviceCommand}" CommandParameter="cash-drawer">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="150">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Background="#1AF59E0B" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="HARDWARE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="0" Text="💵" FontSize="26" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Text="Cash Drawer" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Text="Simulate status inputs and kick trigger feedback for cash drawer drawers." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="14"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </UniformGrid>
    </StackPanel>
</UserControl>

<UserControl x:Class="DeviceMocker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!-- Hero Section -->
        <Border Style="{StaticResource CardStyle}" Padding="28">
            <StackPanel>
                <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding AppDescription}" FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{Binding AppVersion}" FontSize="12"
                               Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="  •  " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AppAuthor}" FontSize="12"
                               Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="  •  " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AppGitHub}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Quick Actions -->
        <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,12"/>

        <UniformGrid Columns="4" Margin="0,0,0,20">
            <Button Style="{StaticResource DeviceButtonStyle}" Margin="0,0,8,0"
                    Command="{Binding QuickActionCommand}" CommandParameter="scanner">
                <StackPanel>
                    <TextBlock Text="SCAN" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="Barcode / QR" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DeviceButtonStyle}" Margin="4,0"
                    Command="{Binding QuickActionCommand}" CommandParameter="keyboard">
                <StackPanel>
                    <TextBlock Text="KB" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="Virtual Keyboard" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DeviceButtonStyle}" Margin="4,0"
                    Command="{Binding QuickActionCommand}" CommandParameter="panel">
                <StackPanel>
                    <TextBlock Text="BTN" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="Button Panel" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DeviceButtonStyle}" Margin="8,0,0,0"
                    Command="{Binding QuickActionCommand}" CommandParameter="serial">
                <StackPanel>
                    <TextBlock Text="COM" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="Serial Device" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Recent Logs -->
        <TextBlock Text="Recent Activity" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding RecentLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="0,8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DeviceName}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Payload}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" FontSize="12" HorizontalAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="OK"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                        <Setter Property="Text" Value="FAIL"/>
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No recent activity" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentLogs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

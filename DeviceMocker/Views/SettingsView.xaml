<UserControl x:Class="DeviceMocker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">

        <TextBlock Text="Application Settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Configure default behavior and appearance for DeviceMocker."
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

        <!-- Output Defaults -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="OUTPUT DEFAULTS" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Delay per Character (ms)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding DefaultDelay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Default Suffix" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SuffixOptions}" SelectedItem="{Binding DefaultSuffix}"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Default Output Channel" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding OutputChannelOptions}"
                          SelectedItem="{Binding DefaultOutputChannel}"
                          Style="{StaticResource ModernComboBoxStyle}"/>
            </StackPanel>
        </Border>

        <!-- Behavior -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Countdown Before Send (seconds)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Max Log Entries (in-memory)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding MaxLogEntries, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 PreviewTextInput="NumericOnly_PreviewTextInput"/>
                    </StackPanel>
                </Grid>

                <CheckBox Content="Persist logs to file"
                          IsChecked="{Binding LogToFile}"
                          Style="{StaticResource ModernCheckBoxStyle}"/>
                <TextBlock Text="When enabled, activity logs are also written to disk for later review."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="28,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Theme" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                          Style="{StaticResource ModernComboBoxStyle}"/>
                <TextBlock Text="Theme changes apply immediately."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Save Settings"
                    Style="{StaticResource BaseButtonStyle}" Command="{Binding SaveCommand}"/>
            <Button Grid.Column="2" Content="Reset to Defaults"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ResetDefaultsCommand}"/>
            <TextBlock Grid.Column="3" Text="{Binding StatusMessage}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       FontSize="12" Margin="16,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </StackPanel>
</UserControl>

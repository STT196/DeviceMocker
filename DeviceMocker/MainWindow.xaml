<Window x:Class="DeviceMocker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeviceMocker.ViewModels"
        xmlns:views="clr-namespace:DeviceMocker.Views"
        xmlns:scanner="clr-namespace:DeviceMocker.Devices.Scanner"
        xmlns:vkb="clr-namespace:DeviceMocker.Devices.VirtualKeyboard"
        xmlns:pos="clr-namespace:DeviceMocker.Devices.PosPanel"
        xmlns:serial="clr-namespace:DeviceMocker.Devices.SerialDevice"
        xmlns:scale="clr-namespace:DeviceMocker.Devices.Scale"
        xmlns:rfid="clr-namespace:DeviceMocker.Devices.RfidReader"
        xmlns:mag="clr-namespace:DeviceMocker.Devices.MagstripeReader"
        xmlns:seq="clr-namespace:DeviceMocker.Devices.SequenceBuilder"
        Title="DeviceMocker — Hardware Input Device Simulator"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}"><views:DevicesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type scanner:ScannerViewModel}"><scanner:ScannerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vkb:VirtualKeyboardViewModel}"><vkb:VirtualKeyboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type pos:PosPanelViewModel}"><pos:PosPanelView/></DataTemplate>
        <DataTemplate DataType="{x:Type serial:SerialDeviceViewModel}"><serial:SerialDeviceView/></DataTemplate>
        <DataTemplate DataType="{x:Type scale:ScaleViewModel}"><scale:ScaleView/></DataTemplate>
        <DataTemplate DataType="{x:Type rfid:RfidReaderViewModel}"><rfid:RfidReaderView/></DataTemplate>
        <DataTemplate DataType="{x:Type mag:MagstripeReaderViewModel}"><mag:MagstripeReaderView/></DataTemplate>
        <DataTemplate DataType="{x:Type seq:SequenceBuilderViewModel}"><seq:SequenceBuilderView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                    <TextBlock Text="DeviceMocker" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Hardware Simulator" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,0,0,14">
                    <TextBlock Text="v1.0.0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Run Text="by " Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Run Text="x1n-Q" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,8"/>
                    <Button Content="Dashboard" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <Button Content="Devices" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Devices"/>
                    <Button Content="Profiles" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Profiles"/>
                    <Button Content="Logs" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Logs"/>
                    <Button Content="Settings" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Back" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoBackCommand}" Padding="12,6" Margin="0,0,16,0" FontSize="12"/>
                    <TextBlock Text="{Binding CurrentPageTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource PrimaryBrush}">
                <ContentControl Content="{Binding CurrentPage}" Margin="24,20"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>

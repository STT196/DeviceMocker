<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>DeviceMocker</AssemblyTitle>
    <Product>DeviceMocker</Product>
    <Description>Windows toolkit for simulating device input and emulating POS printer and cash drawer workflows.</Description>
    <Company>xinQ</Company>
    <Authors>Daniel Depaor</Authors>
    <PublisherName>xinQ</PublisherName>
    <Copyright>Copyright (c) Daniel Depaor</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <ApplicationIcon>Assets\DeviceMocker.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DeviceMocker.ico" />
  </ItemGroup>

  <Target Name="BundleHardwareTestAppForBuild" AfterTargets="Build">
    <MSBuild Projects="..\Samples\PosHardwareTestApp\PosHardwareTestApp.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);OutDir=$(TargetDir)PosHardwareTestApp\" />
  </Target>

  <Target Name="BundleHardwareTestAppForPublish" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;..\Samples\PosHardwareTestApp\PosHardwareTestApp.csproj&quot; -c $(Configuration) -r $(RuntimeIdentifier) -p:SelfContained=$(SelfContained) -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o &quot;$(PublishDir)PosHardwareTestApp&quot;" />
  </Target>

</Project>

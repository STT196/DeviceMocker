<UserControl x:Class="DeviceMocker.Devices.VirtualKeyboard.VirtualKeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Virtual Keyboard" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="Click keys to send them to the active window" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <CheckBox IsChecked="{Binding SendWithCountdown}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Send with 3-second countdown" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Function Keys -->
        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Function Keys" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="F1" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F1"/>
                    <Button Content="F2" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F2"/>
                    <Button Content="F3" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F3"/>
                    <Button Content="F4" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F4"/>
                    <Button Content="F5" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F5"/>
                    <Button Content="F6" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F6"/>
                    <Button Content="F7" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F7"/>
                    <Button Content="F8" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F8"/>
                    <Button Content="F9" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F9"/>
                    <Button Content="F10" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F10"/>
                    <Button Content="F11" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F11"/>
                    <Button Content="F12" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="F12"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Numbers -->
        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Numbers" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="1" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="1"/>
                    <Button Content="2" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="2"/>
                    <Button Content="3" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="3"/>
                    <Button Content="4" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="4"/>
                    <Button Content="5" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="5"/>
                    <Button Content="6" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="6"/>
                    <Button Content="7" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="7"/>
                    <Button Content="8" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="8"/>
                    <Button Content="9" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="9"/>
                    <Button Content="0" Style="{StaticResource DeviceButtonStyle}" Width="56" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Letters -->
        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Letters" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="Q" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="q"/>
                    <Button Content="W" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="w"/>
                    <Button Content="E" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="e"/>
                    <Button Content="R" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="r"/>
                    <Button Content="T" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="t"/>
                    <Button Content="Y" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="y"/>
                    <Button Content="U" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="u"/>
                    <Button Content="I" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="i"/>
                    <Button Content="O" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="o"/>
                    <Button Content="P" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="p"/>
                    <Button Content="A" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="a"/>
                    <Button Content="S" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="s"/>
                    <Button Content="D" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="d"/>
                    <Button Content="F" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="f"/>
                    <Button Content="G" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="g"/>
                    <Button Content="H" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="h"/>
                    <Button Content="J" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="j"/>
                    <Button Content="K" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="k"/>
                    <Button Content="L" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="l"/>
                    <Button Content="Z" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="z"/>
                    <Button Content="X" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="x"/>
                    <Button Content="C" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="c"/>
                    <Button Content="V" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="v"/>
                    <Button Content="B" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="b"/>
                    <Button Content="N" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="n"/>
                    <Button Content="M" Style="{StaticResource DeviceButtonStyle}" Width="50" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="m"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Special Keys -->
        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Special Keys" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="Space" Style="{StaticResource DeviceButtonStyle}" Width="130" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Space"/>
                    <Button Content="Enter" Style="{StaticResource DeviceButtonStyle}" Width="85" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Enter"/>
                    <Button Content="Tab" Style="{StaticResource DeviceButtonStyle}" Width="75" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Tab"/>
                    <Button Content="Backspace" Style="{StaticResource DeviceButtonStyle}" Width="105" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Backspace"/>
                    <Button Content="Escape" Style="{StaticResource DeviceButtonStyle}" Width="85" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Escape"/>
                    <Button Content="Delete" Style="{StaticResource DeviceButtonStyle}" Width="85" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Delete"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Arrow Keys + Shortcuts -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Arrow Keys" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <StackPanel HorizontalAlignment="Center">
                        <Button Content="Up" Style="{StaticResource DeviceButtonStyle}" Width="64" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Up" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Left" Style="{StaticResource DeviceButtonStyle}" Width="64" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Left"/>
                            <Button Content="Down" Style="{StaticResource DeviceButtonStyle}" Width="64" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Down"/>
                            <Button Content="Right" Style="{StaticResource DeviceButtonStyle}" Width="64" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Right"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Shortcuts" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="Ctrl+C" Style="{StaticResource DeviceButtonStyle}" Width="78" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Ctrl+C"/>
                        <Button Content="Ctrl+V" Style="{StaticResource DeviceButtonStyle}" Width="78" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Ctrl+V"/>
                        <Button Content="Ctrl+A" Style="{StaticResource DeviceButtonStyle}" Width="78" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Ctrl+A"/>
                        <Button Content="Ctrl+Z" Style="{StaticResource DeviceButtonStyle}" Width="78" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Ctrl+Z"/>
                        <Button Content="Ctrl+S" Style="{StaticResource DeviceButtonStyle}" Width="78" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Ctrl+S"/>
                        <Button Content="Ctrl+D" Style="{StaticResource DeviceButtonStyle}" Width="78" Margin="3" Padding="8,10" Command="{Binding SendKeyCommand}" CommandParameter="Ctrl+D"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Text="{Binding CountdownText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>

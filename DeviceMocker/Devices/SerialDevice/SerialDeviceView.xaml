<UserControl x:Class="DeviceMocker.Devices.SerialDevice.SerialDeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Controls -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">

            <TextBlock Text="Serial Text Sender" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Send text data over a serial COM port" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <!-- Mode Toggle -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSimulationMode}" VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Simulation Mode" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="(no hardware needed)" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Simulated Device Selector (only in sim mode) -->
                    <StackPanel Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Simulated Device" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SimDeviceOptions}" SelectedItem="{Binding SelectedSimDevice}"
                                  Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hardware Connection (only when NOT in sim mode) -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Hardware Connection" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="COM Port" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"
                                      Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Baud Rate" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding BaudRateOptions}" SelectedItem="{Binding BaudRate}"
                                      Style="{StaticResource ModernComboBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshPortsCommand}" Margin="0,0,6,0" Padding="12,8"/>
                        <Button Content="Connect" Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding ConnectCommand}" Margin="0,0,6,0" Padding="12,8"/>
                        <Button Content="Disconnect" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DisconnectCommand}" Padding="12,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Payload + Send -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Payload" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Line Ending:" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding LineEndingOptions}" SelectedItem="{Binding SelectedLineEnding}"
                                      Style="{StaticResource ModernComboBoxStyle}" Padding="8,4" FontSize="11" MinWidth="70"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontFamily="Consolas" FontSize="14" MinHeight="50"/>
                    <Button Content="Send" Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding SendCommand}" Margin="0,10,0,0"
                            HorizontalAlignment="Stretch" Padding="16,10" FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Quick Presets (only in sim mode) -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Quick Commands" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Content="READ" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="READ"/>
                        <Button Content="STATUS" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="STATUS"/>
                        <Button Content="WEIGHT" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="WEIGHT"/>
                        <Button Content="ZERO" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="ZERO"/>
                        <Button Content="SCAN" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="SCAN"/>
                        <Button Content="OPEN" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="OPEN"/>
                        <Button Content="TEMP" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,6" Padding="14,8" FontSize="12" FontFamily="Consolas"
                                Command="{Binding PresetCommand}" CommandParameter="TEMP"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Status -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right Panel: Terminal -->
        <Border Grid.Column="1" Background="#0D0D1A" CornerRadius="10" Padding="0" Margin="16,0,0,0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <!-- Terminal Header -->
                <Border DockPanel.Dock="Top" Background="#161628" CornerRadius="10,10,0,0" Padding="14,10">
                    <DockPanel>
                        <TextBlock Text="Serial Terminal" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Clear" HorizontalAlignment="Right"
                                Command="{Binding ClearTerminalCommand}" Padding="10,4" FontSize="11" Cursor="Hand"
                                Foreground="{DynamicResource TextSecondaryBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" TextBlock.Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#2A2A45"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                </Border>

                <!-- Terminal Legend -->
                <Border DockPanel.Dock="Top" Background="#111122" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="10" Margin="0,0,14,0">
                            <Run Text="TX" Foreground="#4ADE80" FontWeight="Bold"/>
                            <Run Text=" = Sent" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <TextBlock FontSize="10" Margin="0,0,14,0">
                            <Run Text="RX" Foreground="#60A5FA" FontWeight="Bold"/>
                            <Run Text=" = Received" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <TextBlock FontSize="10" Margin="0,0,14,0">
                            <Run Text="HEX" Foreground="#A78BFA" FontWeight="Bold"/>
                            <Run Text=" = Hex bytes" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                        <TextBlock FontSize="10">
                            <Run Text="SYS" Foreground="#FBBF24" FontWeight="Bold"/>
                            <Run Text=" = System" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Terminal Output -->
                <TextBox Text="{Binding TerminalOutput, Mode=OneWay}" IsReadOnly="True"
                         Background="Transparent" Foreground="#C8D6E5" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12" Padding="14,10"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         VerticalAlignment="Stretch"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

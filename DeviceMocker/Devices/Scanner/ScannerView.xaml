<UserControl x:Class="DeviceMocker.Devices.Scanner.ScannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="520"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Scanner Controls -->
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Barcode / QR Scanner Simulator" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Simulate a real scanner — sends keystrokes to your app" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,20"/>

            <!-- Payload Input -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Scan Payload" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Type:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding BarcodeTypeOptions}" SelectedItem="{Binding SelectedBarcodeType}" Style="{StaticResource ModernComboBoxStyle}" Padding="10,6" FontSize="12" MinWidth="100"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding Payload, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontSize="18" FontFamily="Consolas" Padding="14,12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Generate Random" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource TextPrimaryBrush}" Command="{Binding GenerateRandomCommand}" Padding="14,8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Options: 3 columns with proper spacing -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Prefix" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="Suffix" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SuffixOptions}" SelectedItem="{Binding SelectedSuffix}" Style="{StaticResource ModernComboBoxStyle}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Delay (ms)" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox Text="{Binding DelayPerCharacter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Send Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Send Now" Style="{StaticResource BaseButtonStyle}" Command="{Binding SendNowCommand}" Margin="0,0,8,0" Padding="22,12" FontSize="13"/>
                <Button Content="Send After 3s" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SendAfterCountdownCommand}" Margin="0,0,8,0" Padding="22,12" FontSize="13"/>
                <Button Content="Cancel" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Padding="18,12" FontSize="13"/>
            </StackPanel>

            <!-- Batch Mode -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <CheckBox IsChecked="{Binding IsBatchMode}" VerticalAlignment="Center"/>
                        <TextBlock Text="Batch Scan Mode" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="(fire multiple barcodes)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBatchMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Count" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding BatchCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Interval (ms)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding BatchIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Start Batch Scan" Style="{StaticResource BaseButtonStyle}" Command="{Binding BatchScanCommand}" Padding="16,10" FontSize="13" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Countdown + Status -->
            <TextBlock Text="{Binding CountdownText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- RIGHT: Barcode Library + History -->
        <DockPanel Grid.Column="1" Margin="16,0,0,0">
            <!-- Scan History -->
            <Border DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScanHistory.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Scan History" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Clear" HorizontalAlignment="Right" Command="{Binding ClearHistoryCommand}" Padding="8,4" FontSize="11" Cursor="Hand" Foreground="{StaticResource TextSecondaryBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" TextBlock.Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ScanHistory}" MaxHeight="150">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Cursor="Hand" Margin="0,0,0,3" Command="{Binding DataContext.RescanHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="8,5">
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Sample Barcode Library -->
            <Border Style="{StaticResource CardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Sample Barcodes" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Click any barcode to scan it (3s countdown)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SampleBarcodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Cursor="Hand" Margin="0,0,0,6" Command="{Binding DataContext.ScanSampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentLightBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="DeviceMocker.Devices.MagstripeReader.MagstripeReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock Text="Magstripe Card Reader Simulator" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Simulate card swipes with track data" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Track Data" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding TrackData, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" FontSize="12" FontFamily="Consolas" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Generate Random" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GenerateRandomCommand}" Padding="12,7" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Track" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TrackOptions}" SelectedItem="{Binding SelectedTrack}" Style="{StaticResource ModernComboBoxStyle}" Padding="8,7" FontSize="12"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Suffix" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding SuffixOptions}" SelectedItem="{Binding SelectedSuffix}" Style="{StaticResource ModernComboBoxStyle}" Padding="8,7" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Swipe Now" Style="{StaticResource BaseButtonStyle}" Command="{Binding SendNowCommand}" Margin="0,0,6,0" Padding="20,12" FontSize="13"/>
                <Button Content="Swipe After 3s" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SendAfterCountdownCommand}" Margin="0,0,6,0" Padding="20,12" FontSize="13"/>
                <Button Content="Cancel" Style="{StaticResource DangerButtonStyle}" Command="{Binding CancelCommand}" Padding="16,12" FontSize="13"/>
            </StackPanel>

            <TextBlock Text="{Binding CountdownText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Right: Sample Swipes -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Sample Cards" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Click to swipe (3s countdown)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SampleSwipes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Cursor="Hand" Margin="0,0,0,4"
                                        Command="{Binding DataContext.SwipeSampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding TrackData}" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource AccentLightBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{DynamicResource PrimaryBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CardType}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

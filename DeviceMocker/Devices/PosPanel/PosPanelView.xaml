<UserControl x:Class="DeviceMocker.Devices.PosPanel.PosPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <TextBlock Text="Custom Button Panel" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
        <TextBlock Text="POS-style configurable button panel — click to send actions" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

        <!-- Countdown Toggle -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <CheckBox IsChecked="{Binding SendWithCountdown}" VerticalAlignment="Center"
                      Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Send with 3-second countdown" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Button Grid -->
        <Border Style="{StaticResource CardStyle}" Padding="12">
            <ItemsControl ItemsSource="{Binding Buttons}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="4" MinWidth="110" MinHeight="70" Cursor="Hand"
                                Command="{Binding DataContext.SendButtonCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="8" Padding="14,12"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding Value}" FontSize="10" Opacity="0.7"
                                                       Foreground="{StaticResource AccentLightBrush}" 
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource SecondaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Countdown and Status -->
        <TextBlock Text="{Binding CountdownText}" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
